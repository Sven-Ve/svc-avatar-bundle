{
    "name": "svc/avatar-bundle",
    "description": "get the url for an avatar image as a twig function",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sven Vetter",
            "email": "git.09o@svenvetter.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^6.3 | ^7.2 | ^8",
        "symfony/twig-bundle": "6.3 | ^7.2 | ^8"
    },
    "autoload": {
        "psr-4": {
            "Svc\\AvatarBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Svc\\AvatarBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "symfony/phpunit-bridge": "6.3 | ^7.2 | ^8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3"
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "phpstan": "vendor/bin/phpstan analyse -c .phpstan.neon"
    }
}
